<Window x:Class="MockTax.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MockTax"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Mock Tax Return"
                   FontSize="24"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="RecipientName" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="RecipientNameBox"
                 AutomationProperties.AutomationId="RecipientName"
                 Margin="0,4"/>

        <TextBlock Grid.Row="2" Text="Box2" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="Box2Box"
                 AutomationProperties.AutomationId="Box2"
                 Margin="0,4"/>

        <TextBlock Grid.Row="3" Text="Box14" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 x:Name="Box14Box"
                 AutomationProperties.AutomationId="Box14"
                 Margin="0,4"/>

        <TextBlock Grid.Row="4" Text="Box22" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="Box22Box"
                     AutomationProperties.AutomationId="Box22"
                     Width="250"
                     Margin="0,4,12,4"/>
            <Button x:Name="SaveButton"
                    AutomationProperties.AutomationId="Save"
                    Content="Save"
                    Width="80"
                    Margin="0,4"/>
        </StackPanel>
    </Grid>
</Window>
